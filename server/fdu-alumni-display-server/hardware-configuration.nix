# Do not modify this file!  It was generated by 'nixos-generate-config'
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
#
# 注意：这是占位配置。装机时请在目标机上运行 nixos-generate-config，
# 用生成的 hardware-configuration.nix 覆盖本文件（或用 nixos-anywhere 安装后补齐）。
# 至少要把下面两个 "/dev/disk/by-uuid/TODO" 换成真实 UUID，否则系统无法启动。
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "vmd"
    "xhci_pci"
    "ahci"
    "nvme"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/c4808cf7-33c5-43e1-80d4-e2f99b4f2663";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/E38A-A25A";
    fsType = "vfat";
    options = [
      "fmask=0022"
      "dmask=0022"
    ];
  };

  # SATA 机械盘（ST2000DM008，1.8T）整盘 ext4。
  fileSystems."/mnt/data" = {
    device = "/dev/disk/by-uuid/41fefbf5-44a2-4a67-92b0-80bcdae07594";
    fsType = "ext4";
    options = [
      "defaults"
      "nofail"
    ];
  };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
